<div id="patient-detail" hidden><h2 id="patient-title"></h2><div class="patient-layout">
<section id="plano" class="full"><h2>Plano alimentar</h2><p>Preenchimento exclusivo pelo nutricionista. Salvar cria uma nova versão.</p><p id="plan-version"></p><form id="plan-form"><div id="meals" class="wide"></div><button type="button" id="add-meal" class="secondary">Adicionar refeição</button><label class="wide">Observações gerais<textarea id="plan-notes"></textarea></label><button>Salvar nova versão</button><button type="button" id="send-plan" class="secondary">Enviar plano ao paciente</button></form></section>
<section id="diario" class="full"><h2>Diário e adesão</h2><form id="diary-filter"><label>De<input id="diary-from" type="date"></label><label>Até<input id="diary-until" type="date"></label><button>Filtrar diário</button></form><p id="diary-summary"></p><div id="diary-list"></div></section>
<section id="pesos"><h2>Série de peso</h2><p id="weight-variation"></p><div id="weight-list"></div><form id="weight-form"><label>Peso (kg)<input id="weight" type="number" min="20" max="400" step="0.1" required></label><label>Data e hora (opcional)<input id="weight-date" type="datetime-local"></label><button>Registrar peso</button></form></section>
<section id="metas"><h2>Metas e lembretes</h2><form id="goals-form"><label>Meta diária de copos (opcional)<input id="water-goal" type="number" min="1" step="1"></label><label>Horários de água, separados por vírgula<input id="water-times" placeholder="HH:MM, HH:MM"></label><label class="check"><input id="meal-reminders" type="checkbox">Lembretes das refeições autorizados</label><button>Salvar preferências</button></form></section>
</div></div>
<section id="fila-humano"><h2>Fila humana</h2><button id="refresh-queue" class="secondary">Atualizar fila</button><div id="queue-list"></div></section>
<section id="saida"><h2>Caixa de saída</h2><div class="actions"><button id="refresh-output" class="secondary">Atualizar saída</button><button id="run-tasks">Rodar confirmações e lembretes</button></div><div id="output-list"></div></section>
<section id="faq"><h2>Perguntas frequentes</h2><div id="faq-list"></div><details><summary>Adicionar orientação do consultório</summary><form id="faq-create"><label class="wide">Perguntas (uma por linha)<textarea id="faq-questions" required></textarea></label><label class="wide">Resposta<textarea id="faq-answer" required></textarea></label><button>Salvar orientação</button></form></details></section>
</div></main></body></html>
