function notice(text,error=false){$('"'status').textContent=text;"'$('"'status').classList.toggle('error',error);}
function logout(){session++;token='';patient=null;"'$('"'token').value='';"'$('"'workspace').hidden=true;"'$('"'patient-detail').hidden=true;"'$('"'login').hidden=false;['agenda-list','patient-list','queue-list','output-list','faq-list','meals','diary-list','weight-list','appointment-editor'].forEach(id=>"'$(id).replaceChildren());document.querySelectorAll('"'#workspace form').forEach(f=>f.reset());notice('Sessão encerrada.');}
async function api(path,method='GET',body){
  const generation=session;
  const response=await fetch('/api'+path,{method,headers:{'X-Token':token,'Content-Type':'application/json'},...(body===undefined?{}:{body:JSON.stringify(body)})});
  if(generation"'!==session)throw new Error('"'Sessão encerrada.');
  const data=response.status===204?{}:await response.json();
