"""Estado persistente; uma transação por operação HTTP."""
import json
import shutil
import sqlite3
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


class Error(Exception):
    def __init__(self, status, message):
        self.status = status
        self.message = message


class Store:
    def __init__(self, directory):
        self.directory = Path(directory)
        self.directory.mkdir(parents=True, exist_ok=True)
        config = self.directory / 'nutricao.json'
        if not config.exists():
            shutil.copyfile(ROOT / 'exemplos/nutricao.json', config)
        self.config = json.loads(config.read_text())
        self.path = self.directory / 'estado.sqlite3'
        with self.connect() as db:
            db.execute('CREATE TABLE IF NOT EXISTS registros (colecao TEXT, id TEXT, documento TEXT NOT NULL, PRIMARY KEY (colecao,id))')
            if not db.execute("SELECT 1 FROM registros WHERE colecao='sistema' AND id='semente'").fetchone():
                for collection in ('servicos', 'profissionais', 'faq'):
                    for entry in self.config.get(collection, []):
                        entry = dict(entry)
                        if collection != 'faq':
                            entry['ativo'] = True
                        if collection == 'profissionais':
                            entry.setdefault('registro', None)
                            entry.setdefault('horarios', None)
                        self.save(db, collection, entry)
                self.save(db, 'sistema', {'id': 'semente'})

    def connect(self):
        return sqlite3.connect(self.path, timeout=20)

    def all(self, db, collection):
        return [json.loads(row[0]) for row in db.execute(
            'SELECT documento FROM registros WHERE colecao=? ORDER BY rowid', (collection,))]

    def get(self, db, collection, key):
        row = db.execute('SELECT documento FROM registros WHERE colecao=? AND id=?', (collection, str(key))).fetchone()
        if row is None:
            raise Error(404, 'Registro inexistente')
        return json.loads(row[0])

    def save(self, db, collection, entry):
        if 'id' not in entry:
            row = db.execute('SELECT MAX(CAST(id AS INTEGER)) FROM registros WHERE colecao=?', (collection,)).fetchone()
            entry['id'] = (row[0] or 0) + 1
        db.execute('INSERT INTO registros VALUES (?,?,?) ON CONFLICT(colecao,id) DO UPDATE SET documento=excluded.documento',
                   (collection, str(entry['id']), json.dumps(entry, ensure_ascii=False)))
        return entry
"""Servidor HTTP com autenticação prévia e SQLite transacional."""
import argparse
import hmac
import json
import traceback
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qsl, urlsplit
from .domain import Domain
from .storage import Error, ROOT, Store


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def respond(self, status, body):
        data = json.dumps(body, ensure_ascii=False).encode('utf-8')
        self.send_response(status)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def handle_request(self):
        route = urlsplit(self.path)
        public = (self.command, route.path) in {
            ('GET', '/'), ('GET', '/equipe'), ('GET', '/api/saude'),
            ('GET', '/api/servicos'), ('GET', '/api/horarios'), ('POST', '/api/mensagens')}
        try:
            if not public and not hmac.compare_digest(self.headers.get('X-Token', '').encode(), self.server.store.config['token'].encode()):
                raise Error(401, 'Token inválido')
            body = {}
            if self.command in ('POST', 'PUT'):
                try:
                    body = json.loads(self.rfile.read(int(self.headers.get('Content-Length', '0'))) or b'{}')
                except (ValueError, UnicodeError):
                    raise Error(422, 'JSON inválido')
                if not isinstance(body, dict):
                    raise Error(422, 'JSON deve ser objeto')
            if route.path == '/api/saude' and self.command == 'GET':
                return self.respond(200, {'ok': True, 'versao': (ROOT / 'VERSION').read_text().strip()})
            db = self.server.store.connect()
            try:
                with db:
                    # Reserva a escrita antes de verificar disponibilidade: duas reservas não vencem juntas.
                    db.execute('BEGIN IMMEDIATE')
                    status, result = Domain(self.server.store, db).route(self.command, route.path, dict(parse_qsl(route.query)), body)
            finally:
                db.close()
            self.respond(status, result)
        except Error as exc:
            self.respond(exc.status, {'erro': exc.message})
        except (ValueError, TypeError):
            self.respond(422, {'erro': 'Dados inválidos'})
        except Exception:
            traceback.print_exc()
            self.respond(500, {'erro': 'Erro interno'})

    do_GET = do_POST = do_PUT = do_DELETE = handle_request


def main():
    parser = argparse.ArgumentParser(description='Atendimento do consultório de nutrição')
    commands = parser.add_subparsers(dest='command', required=True)
    serve = commands.add_parser('serve')
    serve.add_argument('--porta', type=int, default=8080)
    serve.add_argument('--dados', required=True)
    serve.add_argument('--host', default='127.0.0.1')
    args = parser.parse_args()
    store = Store(args.dados)
    server = ThreadingHTTPServer((args.host, args.porta), Handler)
    server.store = store
    print(f'PORTA={server.server_address[1]}', flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
#!/usr/bin/env python3
from src.server import main

if __name__ == '__main__':
    main()
