with tempfile.TemporaryDirectory() as tmp:
    env = {k:v for k,v in os.environ.items() if not k.startswith(('EVOLUTION_', 'TELEGRAM_', 'WEBHOOK_', 'ATENDE_'))}
    p = subprocess.Popen(['./atende','serve','--porta','0','--dados',tmp+'/novo'], env=env, stdout=subprocess.PIPE, text=True)
    try:
        port = p.stdout.readline().strip().split('=')[1]
        command = pathlib.Path('Dockerfile').read_text().split('CMD python3 -c \"')[1].split('\"\\n')[0].replace(':8080/', ':'+port+'/')
        subprocess.run(['python3','-c',command], check=True, timeout=5)
        assert pathlib.Path(tmp+'/novo/estado.sqlite3').exists()
        assert pathlib.Path(tmp+'/novo/nutricao.json').exists()
        print('Inicialização em diretório novo e comando de healthcheck: OK')
    finally:
        p.terminate()
        p.wait(timeout=5)
