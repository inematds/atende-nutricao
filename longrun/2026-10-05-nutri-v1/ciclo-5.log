                             "fileLength": "12345"}}
    evo(api_int, message=foto, tipo="imageMessage", msg_id="FOTO-77")
    assert esperar(lambda: any("foto" in norm(t) and "registrad" in norm(t) for t in textos_whats(externo)))
    st, d = api_int.get(f"/api/pacientes/{pid}/diario")
    [reg] = d["registros"]
